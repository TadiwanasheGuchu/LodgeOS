# Copy to .env for local development. Never commit real credentials.
LODGEOS_ENVIRONMENT=development
LODGEOS_DATABASE_URL=postgresql+asyncpg://lodgeos_app:app-dev-only@127.0.0.1:5432/lodgeos
LODGEOS_MIGRATION_DATABASE_URL=postgresql+asyncpg://lodgeos_owner:owner-dev-only@127.0.0.1:5432/lodgeos
LODGEOS_REDIS_URL=redis://127.0.0.1:6379/0
# Local development runs over plain HTTP, so the Secure cookie flag must be off.
LODGEOS_COOKIE_SECURE=false
LODGEOS_CORS_ALLOWED_ORIGINS=http://localhost:3000
